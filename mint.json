{
  "$schema": "https://mintlify.com/schema.json",
  "theme": "venus",
  "colors": {
    "primary": "#0D9373",
    "light": "#07C983",
    "dark": "#0A6B52",
    "background": {
      "dark": "#0F1419"
    }
  },
  "name": "NextPay Gateway API",
  "logo": {
    "dark": "/logo/dark.png",
    "light": "/logo/light.png"
  },
  "favicon": "/logo/favicon.png",

  "openapi": "/openapi.json",
  "api": {
    "baseUrl": "https://api.nextpagamentos.io/api",
    "auth": {
      "method": "key",
      "name": "X-Api-Public-Key",
      "inputPrefix": "nxpay_"
    },
    "playground": {
      "mode": "show"
    }
  },
  "navigation": [
    {
      "tab": "Guias",
      "icon": "book-open",
      "groups": [
        {
          "group": "Começando",
          "icon": "rocket",
          "pages": [
            "introduction",
            "authentication",
            "mcp"
          ]
        }
      ]
    },
    {
      "tab": "Referências da API",
      "icon": "square-terminal",
      "groups": [
        {
          "group": "Transações",
          "icon": "credit-card",
          "pages": [
            "transactions/overview",
            "transactions/response-objects",
            "transactions/create",
            "transactions/get",
            "transactions/webhooks"
          ]
        },
        {
          "group": "Transferências",
          "icon": "arrow-right-arrow-left",
          "pages": [
            "transfers/overview",
            "transfers/response-objects",
            "transfers/create"
          ]
        },
        {
          "group": "Saldo",
          "icon": "wallet",
          "pages": [
            "balance/get"
          ]
        }
      ]
    }
  ],
  "topbarLinks": [
    {
      "name": "Suporte",
      "url": "mailto:suporte@nextpagamentos.io"
    }
  ],
  "topbarCtaButton": {
    "name": "Dashboard",
    "url": "https://app.nextpagamentos.io"
  },
  "footer": {
    "socials": {
      "instagram": "https://instagram.com/nextpagamentos"
    }
  }
}
